CXX_STD = CXX17

UNAME_S := $(shell uname -s)

OBJECTS = dummy.o

LAUNCHER_BIN = ../inst/bin/rdesk-launcher

ifeq ($(UNAME_S), Darwin)
  LAUNCHER_CXXFLAGS = -DWEBVIEW_COCOA=1 -I../inst/include -x objective-c++
  LAUNCHER_LIBS = -framework WebKit -framework Cocoa
else
  WEBKIT_PKG := $(shell pkg-config --exists webkit2gtk-4.1 && echo webkit2gtk-4.1 || echo webkit2gtk-4.0)
  LAUNCHER_CXXFLAGS = -DWEBVIEW_GTK=1 -I../inst/include $(shell pkg-config --cflags gtk+-3.0 $(WEBKIT_PKG))
  LAUNCHER_LIBS = $(shell pkg-config --libs gtk+-3.0 $(WEBKIT_PKG))
endif

all: $(SHLIB) $(LAUNCHER_BIN)
	@if [ -n "$(R_PACKAGE_DIR)" ]; then \
		mkdir -p "$(R_PACKAGE_DIR)/bin"; \
		cp $(LAUNCHER_BIN) "$(R_PACKAGE_DIR)/bin/"; \
	fi

$(LAUNCHER_BIN): launcher.cpp
	mkdir -p ../inst/bin
	$(CXX) -std=c++17 $(LAUNCHER_CXXFLAGS) launcher.cpp $(LAUNCHER_LIBS) -o $(LAUNCHER_BIN)

clean:
	rm -f *.o *.so $(LAUNCHER_BIN)
