CXX_STD = CXX17
OBJECTS = dummy.o
LAUNCHER_BIN = ../inst/bin/rdesk-launcher
STUB_BIN = @STUB_BIN@
STUB_TARGET = @STUB_TARGET@

LAUNCHER_CXXFLAGS = @LAUNCHER_CXXFLAGS@
LAUNCHER_LIBS = @LAUNCHER_LIBS@
IS_MAC = @IS_MAC@

all: $(SHLIB) $(LAUNCHER_BIN) $(STUB_TARGET)
	@if [ -n "$(R_PACKAGE_DIR)" ]; then \
		mkdir -p "$(R_PACKAGE_DIR)/bin"; \
		cp $(LAUNCHER_BIN) "$(R_PACKAGE_DIR)/bin/"; \
		if [ -n "$(STUB_BIN)" ] && [ -f "$(STUB_BIN)" ]; then \
			cp $(STUB_BIN) "$(R_PACKAGE_DIR)/bin/"; \
		fi \
	fi

$(LAUNCHER_BIN): launcher.cpp
	mkdir -p ../inst/bin
	@if [ "$(IS_MAC)" = "yes" ]; then \
		echo "[RDesk] Compiling macOS Universal Launcher..."; \
		$(CXX) -std=c++17 -arch arm64 $(LAUNCHER_CXXFLAGS) launcher.cpp $(LAUNCHER_LIBS) -o $(LAUNCHER_BIN)-arm64; \
		$(CXX) -std=c++17 -arch x86_64 $(LAUNCHER_CXXFLAGS) launcher.cpp $(LAUNCHER_LIBS) -o $(LAUNCHER_BIN)-x86_64; \
		lipo -create -output $(LAUNCHER_BIN) $(LAUNCHER_BIN)-arm64 $(LAUNCHER_BIN)-x86_64; \
		codesign --force --sign - --timestamp=none $(LAUNCHER_BIN); \
		rm -f $(LAUNCHER_BIN)-arm64 $(LAUNCHER_BIN)-x86_64; \
	else \
		$(CXX) -std=c++17 $(LAUNCHER_CXXFLAGS) launcher.cpp $(LAUNCHER_LIBS) -o $(LAUNCHER_BIN); \
	fi

$(STUB_TARGET): stub_macos.c
	mkdir -p ../inst/bin
	@if [ "$(IS_MAC)" = "yes" ]; then \
		echo "[RDesk] Compiling macOS Universal Stub..."; \
		$(CC) -arch arm64 stub_macos.c -o $(STUB_BIN)-arm64; \
		$(CC) -arch x86_64 stub_macos.c -o $(STUB_BIN)-x86_64; \
		lipo -create -output $(STUB_BIN) $(STUB_BIN)-arm64 $(STUB_BIN)-x86_64; \
		codesign --force --sign - --timestamp=none $(STUB_BIN); \
		rm -f $(STUB_BIN)-arm64 $(STUB_BIN)-x86_64; \
	fi

clean:
	rm -f *.o *.so $(LAUNCHER_BIN) $(STUB_BIN)
