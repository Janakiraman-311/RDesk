/* {{APP_NAME}} - System (Auto) Theme (Native Desktop Workbench) */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #f6f7f9;
  --surface: #ffffff;
  --surface-subtle: #f1f3f6;
  --surface-hover: #f8f9fb;
  --header-bg: #ffffff;
  --sidebar-bg: #fbfcfd;
  --status-bg: #f1f3f6;
  --border: #e2e6ed;
  --border-subtle: #edf0f5;
  --text: #111827;
  --text-secondary: #4b5563;
  --text-muted: #6b7280;
  --accent: #2563eb;
  --accent-text: #2563eb;
  --accent-hover: #1d4ed8;
  --accent-soft: rgba(37, 99, 235, 0.1);
  --accent-border: rgba(37, 99, 235, 0.25);
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --cyl4-bg: rgba(2, 132, 199, 0.12);
  --cyl4-fg: #0369a1;
  --cyl6-bg: rgba(124, 58, 237, 0.12);
  --cyl6-fg: #6d28d9;
  --cyl8-bg: rgba(234, 88, 12, 0.12);
  --cyl8-fg: #c2410c;
  --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-sm: 0 2px 6px rgba(15, 23, 42, 0.05);
  --radius-sm: 6px;
  --radius: 10px;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
  --font-mono: "JetBrains Mono", "Cascadia Code", "SF Mono", Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0b0e14;
    --surface: #141821;
    --surface-subtle: #1b2130;
    --surface-hover: #1d2434;
    --header-bg: #11151e;
    --sidebar-bg: #10141d;
    --status-bg: #0e121a;
    --border: #232a3b;
    --border-subtle: #1c2231;
    --text: #e6eaf2;
    --text-secondary: #a6b0c3;
    --text-muted: #7b869c;
    --accent: #3b82f6;
    --accent-text: #60a5fa;
    --accent-hover: #2563eb;
    --accent-soft: rgba(59, 130, 246, 0.14);
    --accent-border: rgba(59, 130, 246, 0.32);
    --success: #34d399;
    --warning: #fbbf24;
    --danger: #f87171;
    --cyl4-bg: rgba(56, 189, 248, 0.16);
    --cyl4-fg: #38bdf8;
    --cyl6-bg: rgba(167, 139, 250, 0.16);
    --cyl6-fg: #c4b5fd;
    --cyl8-bg: rgba(251, 146, 60, 0.16);
    --cyl8-fg: #fdba74;
    --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.28);
    --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);
  }
}

html, body {
  height: 100%;
  overflow: hidden;
  font-family: var(--font-sans);
  font-size: 13px;
  background: var(--bg);
  color: var(--text);
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* Header Bar */
.app-header {
  height: 48px;
  flex-shrink: 0;
  background: var(--header-bg);
  border-bottom: 1px solid var(--border);
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.brand-mark {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-text);
  border: 1px solid var(--accent-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.app-header h1 {
  font-size: 14px;
  font-weight: 650;
  color: var(--text);
  letter-spacing: -0.015em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.version-pill {
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 500;
  color: var(--text-muted);
  background: var(--surface-subtle);
  border: 1px solid var(--border);
  padding: 1px 7px;
  border-radius: 999px;
  white-space: nowrap;
}

/* Header Navigation Tabs */
.header-tabs {
  display: flex;
  align-items: center;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 2px;
  gap: 2px;
}

.nav-tab {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.nav-tab:hover {
  color: var(--text);
}

.nav-tab.active {
  background: var(--surface);
  color: var(--text);
  font-weight: 600;
  box-shadow: var(--shadow-xs);
}

/* Header Action Buttons */
.header-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.btn-ghost, .btn-secondary, .btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border-radius: var(--radius-sm);
  font-family: inherit;
  font-size: 12px;
  font-weight: 550;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  white-space: nowrap;
}

.btn-ghost {
  padding: 6px 10px;
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

.btn-ghost:hover {
  background: var(--surface-subtle);
  color: var(--text);
}

.btn-secondary {
  padding: 7px 12px;
  background: var(--surface-subtle);
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  background: var(--surface-hover);
}

.btn-primary {
  padding: 7px 12px;
  background: var(--accent);
  color: #ffffff;
  border: 1px solid transparent;
}

.btn-primary:hover {
  background: var(--accent-hover);
}

.btn-sm {
  padding: 6px 11px;
}

.btn-block {
  width: 100%;
}

/* Workspace Body */
.app-container {
  flex: 1;
  min-height: 0;
  display: flex;
}

/* Sidebar */
.app-sidebar {
  width: 248px;
  flex-shrink: 0;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 16px 14px;
  overflow-y: auto;
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sidebar-section-title {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.sidebar-divider {
  height: 1px;
  background: var(--border-subtle);
  margin: 16px 0;
}

.control-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
  transition: opacity 0.15s ease;
}

.control-group.is-muted {
  opacity: 0.48;
}

.control-group label {
  font-size: 11.5px;
  font-weight: 550;
  color: var(--text-secondary);
}

.form-select {
  width: 100%;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font-family: inherit;
  font-size: 12.5px;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.form-select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-soft);
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 2px;
  gap: 2px;
}

.seg-btn {
  padding: 5px 4px;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 11.5px;
  font-weight: 550;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.seg-btn:hover {
  color: var(--text);
}

.seg-btn.active {
  background: var(--surface);
  color: var(--accent-text);
  font-weight: 600;
  box-shadow: var(--shadow-xs);
}

/* Sidebar Session Card */
.sidebar-footer {
  margin-top: auto;
  padding-top: 16px;
}

.session-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 11px 12px;
  box-shadow: var(--shadow-xs);
}

.session-card-head {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 5px;
}

.session-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
}

.session-title {
  font-size: 11.5px;
  font-weight: 650;
  color: var(--text);
}

.mono-pill {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  background: var(--surface-subtle);
  padding: 1px 6px;
  border-radius: 4px;
}

.session-meta {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-link {
  background: none;
  border: none;
  padding: 0;
  color: var(--accent-text);
  font-family: inherit;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
}

.session-link:hover {
  text-decoration: underline;
}

/* Main Content */
.app-main {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
  padding: 18px 20px;
  background: var(--bg);
}

.workspace-view[hidden] {
  display: none;
}

/* KPI Cards */
.kpi-bar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

@media (max-width: 960px) {
  .kpi-bar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.kpi-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 13px 15px;
  box-shadow: var(--shadow-xs);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kpi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kpi-icon {
  color: var(--text-muted);
  opacity: 0.7;
}

.kpi-value {
  font-size: 23px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.025em;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.kpi-value-sm {
  font-size: 17px;
}

.kpi-sub {
  font-size: 11.5px;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Dashboard Grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media (min-width: 1020px) {
  .dashboard-grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: start;
  }
}

.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  box-shadow: var(--shadow-xs);
  min-width: 0;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border-subtle);
  flex-wrap: wrap;
}

.panel-title-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-title {
  font-size: 13.5px;
  font-weight: 650;
  color: var(--text);
  letter-spacing: -0.01em;
}

.badge-subtle {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--text-secondary);
  background: var(--surface-subtle);
  border: 1px solid var(--border);
  padding: 2px 7px;
  border-radius: 999px;
  font-variant-numeric: tabular-nums;
}

/* Chart Stage */
.chart-stage {
  border-radius: 8px;
  overflow: hidden;
  background: var(--surface);
  min-height: 280px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 6px;
  transition: opacity 0.18s ease;
}

.chart-img.is-loading {
  opacity: 0.45;
}

/* Live Search Input */
.search-box {
  position: relative;
  display: flex;
  align-items: center;
  width: 190px;
}

.search-icon {
  position: absolute;
  left: 9px;
  color: var(--text-muted);
  pointer-events: none;
}

.search-box input {
  width: 100%;
  padding: 5px 24px 5px 28px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg);
  color: var(--text);
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.search-box input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-soft);
}

.search-clear {
  position: absolute;
  right: 6px;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
  padding: 0 3px;
}

.search-clear:hover {
  color: var(--text);
}

/* Sticky-Header Data Table */
.table-wrap {
  overflow: auto;
  max-height: 410px;
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

thead th {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--surface-subtle);
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 650;
  color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
  user-select: none;
}

thead th.sortable {
  cursor: pointer;
}

thead th.sortable:hover {
  color: var(--text);
}

.sort-ind {
  font-size: 9px;
  color: var(--accent-text);
}

tbody td {
  padding: 7px 10px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text);
  white-space: nowrap;
}

tbody tr:last-child td {
  border-bottom: none;
}

tbody tr:hover td {
  background: var(--surface-hover);
}

.col-left { text-align: left; }
.col-right { text-align: right; }
.col-center { text-align: center; }

.num-cell, .mono-num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.model-name {
  font-weight: 550;
  color: var(--text);
}

.cyl-badge {
  display: inline-block;
  min-width: 22px;
  padding: 1px 6px;
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.cyl-4 { background: var(--cyl4-bg); color: var(--cyl4-fg); }
.cyl-6 { background: var(--cyl6-bg); color: var(--cyl6-fg); }
.cyl-8 { background: var(--cyl8-bg); color: var(--cyl8-fg); }

.trans-tag {
  font-size: 11px;
  font-weight: 500;
  color: var(--text-secondary);
}

.trans-manual {
  color: var(--accent-text);
}

.table-empty {
  text-align: center;
  padding: 28px 12px;
  color: var(--text-muted);
}

/* Runtime & Environment View */
.view-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.view-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.015em;
}

.view-subtitle {
  font-size: 12.5px;
  color: var(--text-muted);
  margin-top: 2px;
}

.runtime-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media (min-width: 960px) {
  .runtime-grid {
    grid-template-columns: 1.15fr 1fr;
  }
}

.path-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.path-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  background: var(--bg);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  font-size: 11.5px;
  word-break: break-all;
}

.path-idx {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  background: var(--accent-soft);
  color: var(--accent-text);
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kv-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
}

.kv-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  font-size: 12px;
}

.kv-key {
  color: var(--text-muted);
  flex-shrink: 0;
}

.kv-val {
  color: var(--text);
  text-align: right;
  word-break: break-all;
}

.mono-text {
  font-family: var(--font-mono);
  font-size: 11.5px;
}

.pkg-chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.pkg-chip {
  font-family: var(--font-mono);
  font-size: 11.5px;
  padding: 4px 9px;
  border-radius: var(--radius-sm);
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text-secondary);
}

/* Docked Desktop Status Bar */
.status-bar {
  height: 28px;
  flex-shrink: 0;
  background: var(--status-bg);
  border-top: 1px solid var(--border);
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
}

.status-left, .status-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
}

.status-dot.busy {
  background: var(--warning);
}

.status-dot.error {
  background: var(--danger);
}

.status-label {
  font-weight: 550;
  color: var(--text-secondary);
}

.status-meta {
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
}

.status-sep {
  opacity: 0.4;
}
