#!/bin/sh

# Detect OS
UNAME_S=`uname -s`

if [ "$UNAME_S" = "Darwin" ]; then
  # The vendored webview header and newer Apple SDK headers emit compatibility
  # warnings that would otherwise fail strict R CMD check builds.
  MAC_WARNING_FLAGS="-Wno-unknown-warning-option -Wno-deprecated-declarations -Wno-deprecated-literal-operator"
  LAUNCHER_CXXFLAGS="-DWEBVIEW_COCOA=1 -I../inst/include -x objective-c++ $MAC_WARNING_FLAGS"
  PKG_CXXFLAGS="$MAC_WARNING_FLAGS"
  LAUNCHER_LIBS="-framework WebKit -framework Cocoa"
  STUB_BIN="../inst/bin/rdesk-stub-macos"
  STUB_TARGET="../inst/bin/rdesk-stub-macos"
  IS_MAC="yes"
else
  # Linux/Unix - check for GTK3 and webkit2gtk
  if ! pkg-config --exists gtk+-3.0; then
    echo "ERROR: GTK3 dev headers not found. Install with:"
    echo "  Ubuntu/Debian: sudo apt-get install libgtk-3-dev"
    echo "  Fedora/RHEL:   sudo dnf install gtk3-devel"
    echo "  Arch Linux:    sudo pacman -S gtk3"
    exit 1
  fi

  if pkg-config --exists webkit2gtk-4.1; then
    WEBKIT_PKG="webkit2gtk-4.1"
  elif pkg-config --exists webkit2gtk-4.0; then
    WEBKIT_PKG="webkit2gtk-4.0"
  else
    echo "ERROR: webkit2gtk-4.1 or webkit2gtk-4.0 dev headers not found. Install with:"
    echo "  Ubuntu/Debian: sudo apt-get install libwebkit2gtk-4.1-dev"
    echo "  Fedora/RHEL:   sudo dnf install webkit2gtk3-devel"
    echo "  Arch Linux:    sudo pacman -S webkit2gtk"
    exit 1
  fi
  
  GTK_CFLAGS=`pkg-config --cflags gtk+-3.0 $WEBKIT_PKG`
  GTK_LIBS=`pkg-config --libs gtk+-3.0 $WEBKIT_PKG`
  
  LAUNCHER_CXXFLAGS="-DWEBVIEW_GTK=1 -I../inst/include $GTK_CFLAGS"
  PKG_CXXFLAGS=""
  LAUNCHER_LIBS="$GTK_LIBS"
  STUB_BIN=""
  STUB_TARGET="stub_dummy"
  IS_MAC="no"
fi

# Substitute variables in src/Makevars.in to generate src/Makevars
sed -e "s|@LAUNCHER_CXXFLAGS@|$LAUNCHER_CXXFLAGS|g" \
    -e "s|@PKG_CXXFLAGS@|$PKG_CXXFLAGS|g" \
    -e "s|@LAUNCHER_LIBS@|$LAUNCHER_LIBS|g" \
    -e "s|@STUB_BIN@|$STUB_BIN|g" \
    -e "s|@STUB_TARGET@|$STUB_TARGET|g" \
    -e "s|@IS_MAC@|$IS_MAC|g" \
    src/Makevars.in > src/Makevars

exit 0
